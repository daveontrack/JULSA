model blog_posts {
  id             String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  title          String    @db.VarChar(300)
  slug           String    @unique @db.VarChar(350)
  excerpt        String
  content        String?
  category       String    @db.VarChar(100)
  post_type      String    @db.VarChar(50)
  author         String    @db.VarChar(255)
  author_role    String?   @db.VarChar(150)
  published_date String?   @db.VarChar(100)
  read_time      String?   @default("5 min read") @db.VarChar(50)
  tags           String[]  @default([])
  featured       Boolean?  @default(false)
  views          Int?      @default(0)
  created_at     DateTime? @default(now()) @db.Timestamptz(6)
  updated_at     DateTime? @default(now()) @db.Timestamptz(6)

  @@index([category], map: "idx_blog_category")
  @@index([featured], map: "idx_blog_featured")
  @@schema("public")
}

