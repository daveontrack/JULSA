model competition_registrations {
  id                String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  competition_id    String?       @db.Uuid
  team_name         String        @db.VarChar(255)
  lead_student_name String        @db.VarChar(255)
  lead_student_id   String        @db.VarChar(50)
  lead_email        String        @db.VarChar(255)
  lead_phone        String        @db.VarChar(50)
  team_members      Json?         @default("[]")
  memorial_file_url String?
  status            String?       @default("Pending") @db.VarChar(50)
  created_at        DateTime?     @default(now()) @db.Timestamptz(6)
  competitions      competitions? @relation(fields: [competition_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@schema("public")
}

